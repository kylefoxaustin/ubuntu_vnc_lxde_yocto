################################################################################
# ubuntu_vnc_lxde_yocto -- 32-bit ARM (armhf) variant
#
# ⚠️  NOT BUILT OR TESTED. The 2026 cleanup pass rewrote this file to match the
#     amd64 Dockerfile and to remove the same defects (unverified tini download,
#     --allow-unauthenticated, the Node 8 builder stage, the Python 2 backend),
#     but it was NOT built: doing so needs binfmt/qemu-user-static registered on
#     the host and an arm32v7 base that still resolves. Treat it as a starting
#     point, not a working image. If you build it and it works, say so here.
#
# The amd64 Dockerfile IS built and verified -- see README.md.
################################################################################

# qemu-arm-static, so the arm32v7 stage can execute on an x86 builder.
FROM ubuntu:18.04 AS qemu
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends qemu-user-static \
    && rm -rf /var/lib/apt/lists/*

################################################################################
FROM arm32v7/ubuntu:18.04
LABEL maintainer="kylefoxaustin"

COPY --from=qemu /usr/bin/qemu-arm-static /usr/bin/

ARG DEBIAN_FRONTEND=noninteractive
ARG localbuild
RUN if [ -n "$localbuild" ]; then \
        sed -i 's#http://ports.ubuntu.com/#http://tw.ports.ubuntu.com/#' /etc/apt/sources.list; \
    fi

################################################################################
# Desktop, VNC and web stack.
#
# Split across three apt layers deliberately: the original comment
# "install debs error if combine together" records that combining them failed
# under emulation, and that is worth preserving until someone proves otherwise.
#
# --allow-unauthenticated removed (it disabled package signature verification).
# The `add-apt-repository -r ppa:fcwu-tw/apps` calls are gone too -- they removed
# a PPA that was never added.
################################################################################
RUN apt-get update && apt-get install -y --no-install-recommends \
        supervisor nginx sudo net-tools ca-certificates curl apache2-utils \
        vim-tiny zenity xz-utils \
        dbus-x11 x11-utils alsa-utils \
        mesa-utils libgl1-mesa-dri \
        websockify \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN apt-get update && apt-get install -y --no-install-recommends \
        lxde xvfb x11vnc \
        firefox chromium-browser \
        fonts-ubuntu ttf-wqy-zenhei \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN apt-get update && apt-get install -y --no-install-recommends \
        gtk2-engines-murrine gtk2-engines-pixbuf gnome-themes-standard arc-theme \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

################################################################################
# tini -- pinned AND checksum verified (was a bare unverified ADD).
################################################################################
ARG TINI_VERSION=v0.19.0
ARG TINI_SHA256=5a9b35f09ad2fb5d08f11ceb84407803a1deff96cbdc0d1222f9f8323f3f8ad4
RUN curl -fsSLo /bin/tini \
        "https://github.com/krallin/tini/releases/download/${TINI_VERSION}/tini-armhf" \
    && echo "${TINI_SHA256}  /bin/tini" | sha256sum -c - \
    && chmod +x /bin/tini

################################################################################
# Web assets. Static noVNC only -- no Node build stage, no Python backend.
################################################################################
COPY web/static/ /usr/local/lib/web/frontend/static/
COPY image/ /

EXPOSE 80 5900

WORKDIR /root
ENV TERM=xterm \
    HOME=/root \
    SHELL=/bin/bash

HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=3 \
    CMD curl -fsS http://127.0.0.1/ >/dev/null || exit 1

ENTRYPOINT ["/startup.sh"]
